{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [{ "type": "command", "command": "node .claude/hooks/guard-protected.mjs" }]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{ "type": "command", "command": "node .claude/hooks/format-lint.mjs" },
					{ "type": "command", "command": "node .claude/hooks/post-edit-advisor.mjs" }
				]
			}
		]
	}
}
